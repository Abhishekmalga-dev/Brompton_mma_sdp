def build_survey_summary_report(stats: dict) -> str:
    """
    Builds a plain-text, fixed-width tabular report of survey counts for this job run.
    Used for both CloudWatch print() and the SNS summary email (both are plain text,
    so Markdown-style tables won't render correctly in either).
    """
    if not stats:
        return "No surveys were processed in this run.\n"

    survey_col_width = max(
        [len("Survey Name")] + [len(s) for s in stats.keys()] + [len("Total count in Feedback Manager")]
    ) + 2
    count_col_width = 15
    date_col_width = 40

    header = (
        f"{'Survey Name':<{survey_col_width}}"
        f"{'Total Count':<{count_col_width}}"
        f"{'Event Date(s) Processed':<{date_col_width}}"
    )
    separator = "-" * (survey_col_width + count_col_width + date_col_width)

    lines = [header, separator]

    grand_total = 0
    for sname in sorted(stats.keys()):
        total_count = stats[sname]["total_count"]
        event_dates = ", ".join(sorted(stats[sname]["event_dates"]))
        grand_total += total_count
        lines.append(
            f"{sname:<{survey_col_width}}"
            f"{total_count:<{count_col_width}}"
            f"{event_dates:<{date_col_width}}"
        )

    lines.append(separator)
    lines.append(
        f"{'GRAND TOTAL (all surveys)':<{survey_col_width}}"
        f"{grand_total:<{count_col_width}}"
        f"{'':<{date_col_width}}"
    )
    lines.append(separator)
    # Blank placeholder row - fill in manually after reconciling against Feedback Manager
    lines.append(
        f"{'Total count in Feedback Manager':<{survey_col_width}}"
        f"{'':<{count_col_width}}"
        f"{'':<{date_col_width}}"
    )
    lines.append(separator)

    return "\n".join(lines)

