def count_dashboard_records(survey_name, event_date):
    """
    Reads the single, always-overwritten dashboard CSV for this survey,
    filters by raw_invitation_date == event_date, and counts DISTINCT
    raw_contact_record_id.

    CONFIRMED ROOT CAUSE (2026-09-15): the default CSV reader (no
    multiLine/quote/escape options) mis-parses row boundaries whenever a
    field contains an embedded quote or newline character (e.g. free-text
    notes/comments fields) -- shifting columns and silently corrupting or
    dropping individual records. This is invisible in Excel, which parses
    quoted CSV structure correctly and never revealed the problem when
    manually inspected. Fixed by reading with multiLine=True and explicit
    quote/escape handling, matching Spark's proper CSV/RFC-4180 parsing.
    """
    file_key = f"{DASHBOARD_PREFIX}/{DASHBOARD_FILE_MAP[survey_name]}"
    df = (
        spark.read
            .option("header", True)
            .option("multiLine", True)
            .option("quote", '"')
            .option("escape", '"')
            .option("mode", "PERMISSIVE")
            .csv(f"s3://{DASHBOARD_BUCKET}/{file_key}")
    )

    filtered = df.filter(
        F.coalesce(
            F.to_date(F.col(RAW_DASHBOARD_INVITATION_DATE_FIELD), "M/d/yyyy H:mm"),
            F.to_date(F.col(RAW_DASHBOARD_INVITATION_DATE_FIELD), "yyyy-MM-dd HH:mm:ss")
        ) == F.lit(event_date)
    )

    return filtered.select(RAW_DASHBOARD_CONTACT_ID_FIELD).distinct().count()