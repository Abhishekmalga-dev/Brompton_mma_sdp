import sys
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.sql import functions as F

args = getResolvedOptions(sys.argv, ['JOB_NAME'])
sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

# =============================================================================
# Fill in the survey label -> Curated S3 path for each survey you want to
# check. SMS_REL is filled in from what we've already confirmed; add the
# others (e.g. the two email/CSAT surveys) with their real curated_folder
# values from SURVEY_CONFIGS in the production script.
# =============================================================================
CURATED_BUCKET = "psegli-datalakenonprodli-datalake-curated-dev"

SURVEYS_TO_CHECK = {
    "SMS_REL": f"s3://{CURATED_BUCKET}/ccaas/survey_sms_web_relational/",
    # "CUSTOMER_SAT_EMAIL": f"s3://{CURATED_BUCKET}/ccaas/<curated_folder_here>/",
    # "CUSTOMER_REP_SAT_V2": f"s3://{CURATED_BUCKET}/ccaas/<curated_folder_here>/",
}

for survey_label, curated_path in SURVEYS_TO_CHECK.items():
    print(f"\n=========================================================")
    print(f"=== {survey_label} — gap between invitation_date and response_received_date ===")
    print(f"=========================================================")

    try:
        curated_df = spark.read.parquet(curated_path)
    except Exception as e:
        print(f"FAILED to read {curated_path}: {e}")
        continue

    gap_df = (
        curated_df
        .filter(F.col("invitation_date").isNotNull() & F.col("response_received_date").isNotNull())
        .withColumn(
            "gap_days",
            F.datediff(
                F.to_date(F.col("response_received_date")),
                F.to_date(F.col("invitation_date"))
            )
        )
    )

    total_rows = gap_df.count()
    print(f"Total rows with both dates present: {total_rows}")

    if total_rows == 0:
        print("No rows to analyze -- check the S3 path and field names.")
        continue

    print("\n--- Distribution of gap_days (invitation_date -> response_received_date) ---")
    gap_df.groupBy("gap_days").count().orderBy("gap_days").show(50)

    max_gap = gap_df.agg(F.max("gap_days")).collect()[0][0]
    p99_gap = gap_df.approxQuantile("gap_days", [0.99], 0.01)[0]
    p999_gap = gap_df.approxQuantile("gap_days", [0.999], 0.001)[0]
    negative_gaps = gap_df.filter(F.col("gap_days") < 0).count()

    print(f"\nMax gap observed: {max_gap} day(s)")
    print(f"99th percentile gap: {p99_gap} day(s)")
    print(f"99.9th percentile gap: {p999_gap} day(s)")
    print(f"Rows with a NEGATIVE gap (response before invitation -- worth investigating if > 0): {negative_gaps}")

    if negative_gaps > 0:
        print("Sample of negative-gap rows (data quality check, not window sizing):")
        gap_df.filter(F.col("gap_days") < 0).select(
            "contact_record_id", "invitation_date", "response_received_date", "gap_days"
        ).show(10, truncate=False)

# =============================================================================
job.commit()