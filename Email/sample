import sys
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job

args = getResolvedOptions(sys.argv, ['JOB_NAME'])
sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

# =============================================================================
TARGET_DATE = "2026-08-07"

curated_df = spark.read.parquet(
    f"s3://psegli-datalakenonprodli-datalake-curated-dev/"
    f"ccaas/survey_sms_web_relational/event_date={TARGET_DATE}/"
)

print("=== Curated schema ===")
curated_df.printSchema()

print(f"\n=== Curated: first 5 rows for event_date={TARGET_DATE}, ALL columns ===")
curated_df.show(5, truncate=False)

raw_df = spark.read.option("multiLine", "true").json(
    f"s3://psegli-datalakenonprodli-datalake-raw-dev/"
    f"ccaas/survey_api_json/event_date={TARGET_DATE}/"
)

print("\n=== Raw schema ===")
raw_df.printSchema()

print(f"\n=== Raw: first 5 rows, ALL columns ===")
raw_df.show(5, truncate=False)

# =============================================================================
job.commit()